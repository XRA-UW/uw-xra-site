# Apache config for the UW student web deploy at students.washington.edu/xra/.
# Shipped to the server as .htaccess by scripts/deploy-uw.sh. Inert anywhere
# else, and ignored entirely by GitHub Pages, which has no server config.

# Unmatched paths. Every real route is prerendered to its own directory, so
# Apache's DirectoryIndex already serves /xra/hackathon/ from
# hackathon/index.html without help. This only catches genuine typos.
ErrorDocument 404 /xra/404.html

# Hack the AM is now part of the main site at /xra/hackathon/2026/. These four
# pages are indexed and ranking, so they get real 301s rather than being
# deleted: a 301 passes their accumulated ranking to the new URL, which is the
# whole reason for consolidating onto this host rather than GitHub Pages.
#
# RedirectMatch with anchored patterns, NOT plain Redirect. `Redirect` does
# prefix matching and appends the remainder, so `Redirect /xra/hacktheam/`
# would rewrite every asset under that directory into a nonexistent path
# beneath the archive page. These match the four pages and the directory
# index exactly, and nothing else.
RedirectMatch 301 ^/xra/hacktheam/(home|tracks|attend|faq)\.html$ /xra/hackathon/2026/
RedirectMatch 301 ^/xra/hacktheam/?$ /xra/hackathon/2026/

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Hashed asset filenames change on every build, so they are safe to cache hard.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|png|jpg|svg|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
